rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    //  RÉDACTEURS AUTORISÉS (Daily FX, Macro Compass, Set-ups)
    //  ⚠️ Cette liste DOIT être identique à MACRO_EDITORS dans index.html
    //  et à MACRO_EDITORS_FX dans fx-terminal.html.
    //  Pour ajouter un rédacteur : ajoute son email ici ET dans le JS.
    // ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function editorEmails() {
      return [
        'mornaccokevin@gmail.com',
        'malikaboubacarkoda@gmail.com'
        // , 'redacteur3@exemple.com'
      ];
    }
    function isMacroEditor() {
      return isSignedIn()
        && request.auth.token.email != null
        && (request.auth.token.email.lower() in editorEmails());
      // Durcissement optionnel : ajoute
      //   && request.auth.token.email_verified == true
      // pour exiger un email vérifié (pense alors à vérifier ton email).
    }

    // ── MACRO PREP — flux partagé ────────────────────────────────
    //  Lecture : tout utilisateur connecté (tout le monde VOIT).
    //  Écriture : uniquement les rédacteurs autorisés (créer/modifier/supprimer).
    match /macroNotes/{noteId} {
      allow read:   if isSignedIn();
      allow create: if isMacroEditor();
      allow update: if isMacroEditor();
      allow delete: if isMacroEditor();
    }

    // ── RAPPORTS HEBDOMADAIRES PDF (Daily FX) ──────────────────────
    //  Lecture : tout utilisateur connecté. Écriture : rédacteurs.
    //  Le PDF est découpé en morceaux dans la sous-collection « chunks ».
    match /dailyReports/{reportId} {
      allow read:  if isSignedIn();
      allow write: if isMacroEditor();
      match /chunks/{chunkId} {
        allow read:  if isSignedIn();
        allow write: if isMacroEditor();
      }
    }

    // ── CHAT DE L'ALLIANCE ───────────────────────────────────────
    //  Lecture + écriture : tout utilisateur connecté.
    //  Suppression autorisée aux connectés (purge auto des anciens
    //  messages côté client + modération).
    match /macroChat/{msgId} {
      allow read:   if isSignedIn();
      // Création : uniquement pour soi-même (authorUid == son propre uid),
      // texte non vide et borné. Empêche l'usurpation d'auteur.
      allow create: if isSignedIn()
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.authorUid == request.auth.uid;
      // Suppression : son propre message OU un rédacteur (modération/purge).
      allow delete: if isSignedIn()
                    && (isMacroEditor()
                        || resource.data.authorUid == request.auth.uid);
      // Modification réservée aux rédacteurs (épinglage des messages).
      allow update: if isMacroEditor();
    }

    // ── CONFIG PARTAGÉE (attentes de taux du Compass) ────────────
    //  Lecture : tout utilisateur connecté. Écriture : rédacteurs.
    match /config/{doc} {
      allow read:  if isSignedIn();
      allow write: if isMacroEditor();
    }

    // ── MACRO COMPASS — scoring par devise (source : Notion) ─────
    //  Lecture : tout utilisateur connecté. Écriture : rédacteurs
    //  (en pratique, écrit via le compte de service admin, qui
    //  contourne ces règles — restriction gardée en défense en profondeur).
    match /macroCompass/{docId} {
      allow read:  if isSignedIn();
      allow write: if isMacroEditor();
    }

    // ── SET-UPS FONDAMENTAUX — partagés, comme le Daily FX ──────
    //  Lecture : tout utilisateur connecté. Création / modification /
    //  suppression : rédacteurs uniquement (set-up + ses captures).
    match /fundSetups/{setupId} {
      allow read:  if isSignedIn();
      allow write: if isMacroEditor();
      match /shots/{shotId} {
        allow read:  if isSignedIn();
        allow write: if isMacroEditor();
      }
    }

    // ── DONNÉES PRIVÉES — Performance Tracker ────────────────────
    //  Chaque utilisateur n'accède qu'à ses propres trades / capital.
    match /users/{uid}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Tout le reste est refusé par défaut ──────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
